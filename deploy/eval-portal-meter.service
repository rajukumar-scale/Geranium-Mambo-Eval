[Unit]
Description=Geranium Mambo Eval Portal metering proxy (model calls of running reviews)
After=network-online.target
Wants=network-online.target

[Service]
User=evalportal
Group=evalportal
WorkingDirectory=/opt/eval-portal
Environment=PORTAL_ENV_FILE=/opt/eval-portal/.env
ExecStart=/opt/eval-portal/.venv/bin/python -m server.main meter
Restart=always
RestartSec=2
# A deploy restarts this only when server/proxy.py changes; a stop waits for in-flight model calls (up to 10 min).
TimeoutStopSec=620
LimitNOFILE=65536

# Under memory pressure (boat snapshots use ~5 GB) the kernel kills a chat container or a snapshot process first,
# not the portal or the meter (2026-11-03 07:34 the portal was OOM-killed).
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
