[Unit]
Description=Eval portal: deploy main from GitHub when it changes
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/eval-portal/deploy/pull_deploy.sh
# remote_deploy.sh waits up to 5 minutes for runs to finish setting up, plus the tests and the restart.
# Up to 20 min waiting for server reviews + 5 min for the rest + the restart (it was 20 min and killed busy deploys).
TimeoutStartSec=40min
