[Unit]
Description=Geranium Mambo Eval Portal
After=network-online.target docker.service eval-portal-meter.service
Wants=network-online.target eval-portal-meter.service
Requires=docker.service

[Service]
User=evalportal
Group=evalportal
SupplementaryGroups=docker
WorkingDirectory=/opt/eval-portal
Environment=PORTAL_ENV_FILE=/opt/eval-portal/.env
# The metering proxy is its own service (eval-portal-meter.service): restarting the portal never cuts model calls.
Environment=EVP_METER=separate
ExecStart=/opt/eval-portal/.venv/bin/python -m server.main
Restart=always
RestartSec=5
# Reviews on boat boxes are re-attached after a restart; shutdown itself takes ~3 s.
TimeoutStopSec=20
# 50 reviews, their proxied model calls and 50 open chat pages need well over the default 1024 files.
LimitNOFILE=65536
# The portal keeps portal.db (~1 GB) locked in RAM (db._Pin), so a disk the boat snapshot saturates can't stall reads.
LimitMEMLOCK=1G

# Under memory pressure (boat snapshots use ~5 GB) the kernel kills a chat container or a snapshot process first,
# not the portal or the meter (2026-11-03 07:34 the portal was OOM-killed).
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
