# Geranium Mambo Eval Portal settings. Copy to .env (chmod 600). deploy/setup_vm.sh fills the secrets.

# --- runner ---
RUNNER_MODE=docker                      # docker on the VM; local only for development on a laptop
EVAL_BASE_DIR=/srv/eval-base            # holds Evals/, claude/, .claude/ and Universe_Sonorra/
PORTAL_DATA_DIR=/srv/eval-data          # sqlite db + per-attempt inputs, reports, sessions, logs
RUNNER_IMAGE=eval-runner:latest
MAX_CONCURRENT_RUNS=2                   # docker slots for follow-ups on the 8 GB server box
# Multiple boxes: every review gets its own fresh boat.dev box cloned from BOAT_SNAPSHOT.
# Follow-ups stay in the docker slots above. Leave REVIEW_RUNNER empty to run reviews here too.
REVIEW_RUNNER=
BOAT_BIN=/usr/local/bin/boat-cli         # logged in as the service user with a `ci`-preset API key
BOAT_SNAPSHOT=gm-runner                  # built by deploy/build_runner_template.sh
BOAT_BOX_TYPE=default                    # 4 vCPU / 8 GB per review
SERVER_BOX_ID=bx_7r4qxme3
SERVER_REVIEW_SLOTS=0                    # 0 = all reviews run on boat boxes (keeps 8 GB server from OOM)
MAX_BOAT_RUNS=20                         # reviews at once (plan allows 100 boxes; $20 plan = 200 new boxes/day)
PROXY_PUBLIC_URL=                        # https://<server-id>-8001.on.boat.dev (boat host <server> 8001 --public)
BOAT_RESTRICT_EGRESS=1                   # review boxes may reach only the proxy
MODAL_PROXY_URL=https://modal-proxy.internal.scale.com
MODAL_AWS_PROFILE=
MODAL_TEMPLATE_IMAGE=
MODAL_PROJECT_ID=6ae1792488162884415d5ee6
CONTAINER_MEMORY=2g
CONTAINER_CPUS=2
RUN_TIMEOUT_MIN=150
DEFAULT_MODEL=claude-opus-5-5           # all 6 skills also pin Opus 5.5 in their skill files
EVAL_EFFORT=high                        # replaces the skills' pinned effort; rerun deploy/update_eval.sh after changing
SMALL_MODEL=claude-haiku-5-5

# --- keys (server-side only; runs never see them) ---
LITELLM_BASE_URL=https://litellm-proxy.ml.scale.com
LITELLM_API_KEY=
REDASH_URL=https://redash.scale.com
REDASH_API_KEY=
REDASH_LOGIN_QUERY_ID=387117            # "Eval Portal · attempt login check"
ALLOWED_PROJECT_IDS=6ae1792488162884415d5ee6   # comma list; empty = any project
ASSIGNMENT_AUTOFILL=0                   # 0 = contributor selects Persona / Family / Constraint Count in Welcome UI
UNIVERSE_DIRS=Universe_Sonorra
TOOLCALL_NOTE_PILOT=
ENV_CHECK_PILOT=

# --- web ---
HOST=127.0.0.1                          # Caddy terminates HTTPS in front
PORT=8000
TRUST_PROXY=1
COOKIE_SECURE=1
PUBLIC_BASE_URL=https://eval.example.com
DOCKER_NETWORK=evalnet                  # internal docker network: runs reach only the proxy, no internet
PROXY_HOST=172.30.0.1                   # host side of that network; setup_vm.sh sets it
PROXY_PORT=8001
PROXY_URL_FOR_RUNNER=http://172.30.0.1:8001
SESSION_SECRET=
PROOF_SECRET=

# --- limits ---
DAILY_REVIEW_LIMIT=0                    # per attempt per 24h; 0 = no cap
DAILY_FOLLOWUP_LIMIT=0
MAX_CALLS_PER_RUN=0                     # model calls per run; 0 = no cap
BUDGET_QUERY_ID=388350                  # Redash query with the LiteLLM key's budget (admin page panel); 0 = off
CLAIMS_QUERY_ID=388856                  # Redash query: who holds each task now, for the "done, not submitted" debugger
BUDGET_DAILY_QUERY_ID=389171            # Redash query: the key's spend per UTC day (bar chart in the budget popup); 0 = off
COST_DAY_QUERY_ID=389180                # Redash queries behind the admin Cost page: per day, per task, per contributor
COST_TASK_QUERY_ID=389181
COST_PERSON_QUERY_ID=389182
SUBMISSIONS_QUERY_ID=388752             # Redash query: platform submissions, so finished people drop off the admin panel; 0 = off
CB_SPEND_LIMIT_USD=500                  # per attempt (a new attempt starts at $0); reaching it flags + warns (runs not blocked); 0 = off
MAX_UPLOAD_MB=25
CACHE_TTL_DAYS=5                        # eval search caches of idle attempts are cleared after this
KNOWN_ISSUES_PILOT=                     # "Known data issues" sidebar: comma list of emails or Outlier IDs; * = everyone; empty = off
PLAN_PILOT=                             # "Plan my task with the guides" kickoff card before the first /prompt: same format as above
FIX_HELPER_PILOT=                       # fix-help offer from the 2nd /prompt FAIL + "start your Opus run" after a /prompt pass: same format

# --- admins ---
ADMIN_EMAILS=atlasadmin
ADMIN_PASSWORD=
SLACK_WEBHOOK_URL=                      # incoming webhook for /admin alerts, or:
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# --- auto-deploy (deploy/pull_deploy.sh) ---
GITHUB_DEPLOY_TOKEN=                    # fine-grained token, this repo only, Deployments: read and write; empty = no GitHub status
